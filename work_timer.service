[Unit]
Description=Work Timer Check-in Server
After=network.target

[Service]
WorkingDirectory=/opt/eightpointfivetimer
ExecStart=/opt/eightpointfivetimer/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/eightpointfivetimer/.env

[Install]
WantedBy=multi-user.target
