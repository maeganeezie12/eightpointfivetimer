[Unit]
Description=Work Timer Check-in Server
After=network.target

[Service]
WorkingDirectory=/opt/eightpointfivetimer
EnvironmentFile=/opt/eightpointfivetimer/.env
ExecStart=/opt/eightpointfivetimer/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
